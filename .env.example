# ─── DB (Neon) ───────────────────────────────────────────────
# 앱이 쓰는 연결 - Connection pooling을 켠 주소 (`-pooler`)
DATABASE_URL=
# 마이그레이션(prisma migrate)이 쓰는 연결 - Connection pooling을 끈 주소
DIRECT_URL=
# 로컬 Docker DB(마이그레이션 작성·DB 테스트) 주소는 prisma/db-url.ts에 고정돼 있어 적지 않는다

# ─── 인증 (Better Auth) ─────────────────────────────────────
# 세션 쿠키·토큰을 서명하고 암호화하는 열쇠. (terminal - `openssl rand -base64 32`)
# 변경시 데이터는 유지되나 기존 로그인 모두 풀림
BETTER_AUTH_SECRET=
# 앱의 주소 - 로컬은 http://localhost:3000, 운영은 배포 주소
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 정기 작업 (Vercel Cron) ────────────────────────────────
# Vercel이 호출할 때 `Authorization: Bearer <값>`을 붙여 일치 여부 확인
# Cron 호출 확인용 비밀값. (terminal - `openssl rand -base64 32`)
# BETTER_AUTH_SECRET과 다른 값을 쓸 것
CRON_SECRET=

# ─── 테스트 전용 ─────────────────────────────────────────────
# 1이면 E2E 테스트용 로그인 경로(/api/test/login)를 연다. 운영이 아닐 때만 동작한다.
# 평소 개발에는 비워 둔다
E2E_TEST_LOGIN=
